local function getNearestPlayer()
    local character = localPlayer.Character
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local nearest
    local nearestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")

            if root and humanoid and humanoid.Health > 0 then
                local distance = (root.Position - myRoot.Position).Magnitude
                if distance < nearestDistance then
                    nearest = player
                    nearestDistance = distance
                end
            end
        end
    end

    return nearest
end

local function stopLockOn()
    lockOnEnabled = false
    lockTarget = nil
    lockSwitch.BackgroundColor3 = Color3.fromRGB(65, 65, 72)
    switchKnob.Position = UDim2.fromOffset(4, 4)
    lockStatus.Text = "Lock On: OFF"
    lockStatus.TextColor3 = Color3.fromRGB(190, 190, 190)
end

local function startLockOn()
    lockTarget = getNearestPlayer()
    lockOnEnabled = lockTarget ~= nil

    if lockOnEnabled then
        lockSwitch.BackgroundColor3 = Color3.fromRGB(255, 190, 50)
        switchKnob.Position = UDim2.new(1, -26, 0, 4)
        lockStatus.Text = "Locked on: " .. lockTarget.DisplayName
        lockStatus.TextColor3 = Color3.fromRGB(255, 205, 70)
    else
        lockStatus.Text = "Lock On: no player available"
        lockStatus.TextColor3 = Color3.fromRGB(255, 130, 100)
    end
end

lockSwitch.Activated:Connect(function()
    if lockOnEnabled then
        stopLockOn()
    else
        startLockOn()
    end
end)

-- Follow the target with the camera while enabled.
-- The mouse cursor itself remains under Roblox's normal cursor controls.
local cameraConnection = RunService.RenderStepped:Connect(function()
    if not lockOnEnabled then return end

    local camera = workspace.CurrentCamera
    local target = lockTarget
    local character = target and target.Character
    local targetRoot = character and character:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not camera or not targetRoot or not targetHumanoid
        or targetHumanoid.Health <= 0 then
        stopLockOn()
        return
    end

    local cameraPosition = camera.CFrame.Position
    local aimPosition = targetRoot.Position + Vector3.new(0, 1.5, 0)
    camera.CFrame = CFrame.lookAt(cameraPosition, aimPosition)
    lockStatus.Text = "Locked on: " .. target.DisplayName
end)

local function showTab(name)
    movementPage.Visible = name == "Movement"
    visualPage.Visible = name == "Visual"
    combatPage.Visible = name == "Combat"

    for _, info in ipairs({
        {movementTab, "Movement"},
        {visualTab, "Visual"},
        {combatTab, "Combat"}
    }) do
        local active = info[2] == name
        info[1].BackgroundColor3 = active
            and Color3.fromRGB(255, 190, 50)
            or Color3.fromRGB(48, 48, 55)
        info[1].TextColor3 = active
            and Color3.fromRGB(25, 25, 25)
            or Color3.new(1, 1, 1)
    end
end

