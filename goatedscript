		UDim2.fromOffset(14, 52),
		UDim2.fromOffset(190, 40)
	)

	toggle.BackgroundColor3 = highlightsEnabled
		and Color3.fromRGB(50, 145, 85)
		or Color3.fromRGB(60, 62, 82)

	toggle.MouseButton1Click:Connect(function()
		highlightsEnabled = not highlightsEnabled
		toggle.Text = highlightsEnabled and "Highlights: ON" or "Highlights: OFF"
		toggle.BackgroundColor3 = highlightsEnabled
			and Color3.fromRGB(50, 145, 85)
			or Color3.fromRGB(60, 62, 82)

		updatePlayerHighlights()
	end)

	makeLabel(
		content,
		"Highlights show other characters through walls.",
		UDim2.fromOffset(14, 105),
		UDim2.new(1, -28, 0, 45)
	)
end

-- Combat tab: camera lock for testing in your own game
local function restoreCamera()
	local camera = workspace.CurrentCamera
	if camera then
		if originalCameraType then
			camera.CameraType = originalCameraType
		end
		if originalCameraSubject and originalCameraSubject.Parent then
			camera.CameraSubject = originalCameraSubject
		end
	end

	originalCameraType = nil
	originalCameraSubject = nil
	lockedTarget = nil

	if targetHighlight then
		targetHighlight:Destroy()
		targetHighlight = nil
	end
end

local function findNearestPlayer()
	local myCharacter = player.Character
	local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
	if not myRoot then
		return nil
	end

	local nearestPlayer = nil
	local nearestDistance = math.huge

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player and targetPlayer.Character then
			local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
			local targetHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")

			if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
				local distance = (targetRoot.Position - myRoot.Position).Magnitude
				if distance < nearestDistance then
					nearestDistance = distance
					nearestPlayer = targetPlayer
				end
			end
		end
	end

	return nearestPlayer
end

local function enableLockOn()
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end

	lockedTarget = findNearestPlayer()
	if not lockedTarget then
		return false
	end

	originalCameraType = camera.CameraType
	originalCameraSubject = camera.CameraSubject

	local character = lockedTarget.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		lockedTarget = nil
		return false
	end

	targetHighlight = Instance.new("Highlight")
	targetHighlight.Name = "PineappleLockOnHighlight"
	targetHighlight.Adornee = character
	targetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	targetHighlight.FillColor = Color3.fromRGB(255, 65, 65)
	targetHighlight.OutlineColor = Color3.new(1, 1, 1)
	targetHighlight.FillTransparency = 0.65
	targetHighlight.Parent = character

	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = humanoid

	return true
end

local function showCombat()
	clearContent()

	makeLabel(
		content,
		"Lock On",
		UDim2.fromOffset(14, 15),
		UDim2.new(1, -28, 0, 25)
	)

	local toggle = makeButton(
		content,
		lockOnEnabled and "Lock On: ON" or "Lock On: OFF",
		UDim2.fromOffset(14, 52),
		UDim2.fromOffset(190, 40)
	)

	toggle.BackgroundColor3 = lockOnEnabled
		and Color3.fromRGB(50, 145, 85)
		or Color3.fromRGB(60, 62, 82)

	local status = makeLabel(
		content,
		"Finds the nearest player and follows their character.",
		UDim2.fromOffset(14, 105),
		UDim2.new(1, -28, 0, 45)
	)

	toggle.MouseButton1Click:Connect(function()
		if lockOnEnabled then
			lockOnEnabled = false
			restoreCamera()
			toggle.Text = "Lock On: OFF"
			toggle.BackgroundColor3 = Color3.fromRGB(60, 62, 82)
			status.Text = "Lock on disabled."
		else
			local success = enableLockOn()

			if success then
				lockOnEnabled = true
				toggle.Text = "Lock On: ON"
				toggle.BackgroundColor3 = Color3.fromRGB(50, 145, 85)
				status.Text = "Locked onto: " .. lockedTarget.Name
			else
				status.Text = "No available player found."
			end
		end
	end)
end

