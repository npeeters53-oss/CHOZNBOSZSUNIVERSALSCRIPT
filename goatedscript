-- Movement tab
local function showMovement()
	clearContent()

	makeLabel(
		content,
		"Walk Speed",
		UDim2.fromOffset(14, 15),
		UDim2.new(1, -28, 0, 25)
	)

	local speedValue = makeLabel(
		content,
		"Multiplier: " .. speedMultiplier .. "x",
		UDim2.fromOffset(14, 45),
		UDim2.new(1, -28, 0, 25)
	)

	local slider = Instance.new("Frame")
	slider.Size = UDim2.new(1, -28, 0, 12)
	slider.Position = UDim2.fromOffset(14, 82)
	slider.BackgroundColor3 = Color3.fromRGB(70, 72, 90)
	slider.BorderSizePixel = 0
	slider.ZIndex = 5
	slider.Parent = content

	Instance.new("UICorner", slider).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((speedMultiplier - 1) / 4, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(255, 190, 35)
	fill.BorderSizePixel = 0
	fill.ZIndex = 6
	fill.Parent = slider

	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("TextButton")
	knob.Size = UDim2.fromOffset(20, 20)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new((speedMultiplier - 1) / 4, 0, 0.5, 0)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.Text = ""
	knob.ZIndex = 7
	knob.Parent = slider

	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local draggingSlider = false

	local function setSpeedFromX(x)
		local width = math.max(slider.AbsoluteSize.X, 1)
		local alpha = math.clamp(
			(x - slider.AbsolutePosition.X) / width,
			0,
			1
		)

		speedMultiplier = math.clamp(
			math.floor((1 + alpha * 4) * 10 + 0.5) / 10,
			1,
			5
		)

		fill.Size = UDim2.new((speedMultiplier - 1) / 4, 0, 1, 0)
		knob.Position = UDim2.new((speedMultiplier - 1) / 4, 0, 0.5, 0)
		speedValue.Text = "Multiplier: " .. speedMultiplier .. "x"

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16 * speedMultiplier
		end
	end

	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = true
		end
	end)

	slider.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = true
			setSpeedFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			setSpeedFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)

	makeLabel(
		content,
		"Choose a multiplier from 1x to 5x.",
		UDim2.fromOffset(14, 115),
		UDim2.new(1, -28, 0, 30)
	)

	local resetButton = makeButton(
		content,
		"Reset Speed",
		UDim2.fromOffset(14, 160),
		UDim2.fromOffset(130, 36)
	)

	resetButton.MouseButton1Click:Connect(function()
		speedMultiplier = 1
		showMovement()

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16
		end
	end)
end

-- Visual tab
local function removePlayerHighlights()
	for targetPlayer, highlight in pairs(playerHighlights) do
		if highlight then
			highlight:Destroy()
		end
		playerHighlights[targetPlayer] = nil
	end
end

local function updatePlayerHighlights()
	if not highlightsEnabled then
		removePlayerHighlights()
		return
	end

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player and targetPlayer.Character then
			local highlight = playerHighlights[targetPlayer]

			if not highlight or highlight.Parent ~= targetPlayer.Character then
				if highlight then
					highlight:Destroy()
				end

				highlight = Instance.new("Highlight")
				highlight.Name = "PineapplePlayerHighlight"
				highlight.Adornee = targetPlayer.Character
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillColor = Color3.fromRGB(255, 190, 35)
				highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				highlight.FillTransparency = 0.65
				highlight.OutlineTransparency = 0
				highlight.Parent = targetPlayer.Character

				playerHighlights[targetPlayer] = highlight
			end
		end
	end

	for targetPlayer, highlight in pairs(playerHighlights) do
		if not targetPlayer.Parent or not targetPlayer.Character then
			if highlight then
				highlight:Destroy()
			end
			playerHighlights[targetPlayer] = nil
		end
	end
end

local function showVisual()
	clearContent()

	makeLabel(
		content,
		"Player Highlights",
		UDim2.fromOffset(14, 15),
		UDim2.new(1, -28, 0, 25)
	)

	local toggle = makeButton(
		content,
