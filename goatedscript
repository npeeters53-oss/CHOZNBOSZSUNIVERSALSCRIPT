-- Make pineapple button draggable
local draggingButton = false
local dragStart = nil
local startPosition = nil

pineappleButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingButton = true
		dragStart = input.Position
		startPosition = pineappleButton.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingButton and dragStart and startPosition then
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart
			pineappleButton.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingButton = false
	end
end)

-- Reapply movement speed after respawn
local function onCharacterAdded(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.WalkSpeed = 16 * speedMultiplier
	end
end

if player.Character then
	task.spawn(onCharacterAdded, player.Character)
end

player.CharacterAdded:Connect(onCharacterAdded)

-- Keep visuals updated as players join, leave, or respawn
Players.PlayerAdded:Connect(function()
	task.wait(0.5)
	updatePlayerHighlights()
end)

Players.PlayerRemoving:Connect(function(leavingPlayer)
	local highlight = playerHighlights[leavingPlayer]
	if highlight then
		highlight:Destroy()
	end
	playerHighlights[leavingPlayer] = nil

	if lockedTarget == leavingPlayer then
		lockOnEnabled = false
		restoreCamera()
	end
end)

RunService.Heartbeat:Connect(function()
	if highlightsEnabled then
		updatePlayerHighlights()
	end

	if lockOnEnabled then
		local camera = workspace.CurrentCamera
		local character = lockedTarget and lockedTarget.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if not camera or not humanoid or humanoid.Health <= 0 then
			lockOnEnabled = false
			restoreCamera()
		elseif camera.CameraSubject ~= humanoid then
			camera.CameraSubject = humanoid
		end
	end
end)

showMovement()

