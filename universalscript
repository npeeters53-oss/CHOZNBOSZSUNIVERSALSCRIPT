-- Apply speed to the player's character
local function applySpeed()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.WalkSpeed = NORMAL_SPEED * multiplier
	end
end

local function updateSlider(value)
	multiplier = math.clamp(
		math.floor(value * 10 + 0.5) / 10,
		MIN_MULTIPLIER,
		MAX_MULTIPLIER
	)

	local percent = (multiplier - MIN_MULTIPLIER)
		/ (MAX_MULTIPLIER - MIN_MULTIPLIER)

	fill.Size = UDim2.new(percent, 0, 1, 0)
	knob.Position = UDim2.new(percent, 0, 0.5, 0)

	speedLabel.Text = string.format(
		"Speed Multiplier: %.1fx", multiplier
	)

	applySpeed()
end

local function setFromScreenX(screenX)
	local left = track.AbsolutePosition.X
	local width = track.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local percent = math.clamp((screenX - left) / width, 0, 1)
	local value = MIN_MULTIPLIER
		+ percent * (MAX_MULTIPLIER - MIN_MULTIPLIER)

	updateSlider(value)
end

local sliding = false

local function startSliding(input)
	sliding = true
	setFromScreenX(input.Position.X)
end

knob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		startSliding(input)
	end
end)

track.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		startSliding(input)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if sliding and (
		input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
		setFromScreenX(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		sliding = false
	end
end)

-- Toggle menu when the pineapple is clicked
pineapple.Activated:Connect(function()
	menu.Visible = not menu.Visible
end)

-- Drag the pineapple button
local dragging = false
local dragStart
local buttonStart
local dragInput
local moved = false

pineapple.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		moved = false
		dragStart = input.Position
		buttonStart = pineapple.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

pineapple.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (
		input == dragInput
			or input.UserInputType == Enum.UserInputType.MouseMovement
		) then
		local delta = input.Position - dragStart

		if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
			moved = true
		end

		pineapple.Position = UDim2.new(
			buttonStart.X.Scale,
			buttonStart.X.Offset + delta.X,
			buttonStart.Y.Scale,
			buttonStart.Y.Offset + delta.Y
		)
	end
end)

-- Reapply the selected multiplier after respawning
player.CharacterAdded:Connect(function(character)
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.WalkSpeed = NORMAL_SPEED * multiplier
end)

-- Start at 1x speed
updateSlider(1)

print("🍍 PINEAPPLESCRIPTS loaded!")
