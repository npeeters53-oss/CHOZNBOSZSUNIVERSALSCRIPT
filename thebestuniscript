local function applySpeed()
    local character = player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = BASE_SPEED * multiplier
    end
end

local function updateSlider(value)
    multiplier = math.clamp(
        math.floor(value * 10 + 0.5) / 10,
        MIN_MULTIPLIER,
        MAX_MULTIPLIER
    )

    local percent = (multiplier - MIN_MULTIPLIER)
        / (MAX_MULTIPLIER - MIN_MULTIPLIER)

    fill.Size = UDim2.new(percent, 0, 1, 0)
    knob.Position = UDim2.new(percent, 0, 0.5, 0)
    speedLabel.Text = string.format(
        "Speed Multiplier: %.1fx", multiplier
    )
    applySpeed()
end

local function setSliderFromX(x)
    local left = track.AbsolutePosition.X
    local width = track.AbsoluteSize.X
    if width <= 0 then return end

    local percent = math.clamp((x - left) / width, 0, 1)
    updateSlider(MIN_MULTIPLIER +
        percent * (MAX_MULTIPLIER - MIN_MULTIPLIER))
end

local sliding = false
local sliderTouch

local function beginSlider(input)
    sliding = true
    if input.UserInputType == Enum.UserInputType.Touch then
        sliderTouch = input
    end
    setSliderFromX(input.Position.X)
end

track.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        beginSlider(input)
    end
end)

knob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        beginSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliding and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input == sliderTouch
    ) then
        setSliderFromX(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
        sliderTouch = nil
    end
end)

