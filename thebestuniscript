local function setPlayerHighlight(targetPlayer, enabled)
    local character = targetPlayer.Character
    if not character then return end

    local existing = character:FindFirstChild("PineappleHighlight")

    if enabled then
        if not existing then
            local h = Instance.new("Highlight")
            h.Name = "PineappleHighlight"
            h.FillColor = GOLD
            h.OutlineColor = Color3.fromRGB(255, 255, 220)
            h.FillTransparency = 0.65
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.Occluded
            h.Parent = character
        end
    elseif existing then
        existing:Destroy()
    end
end

local function refreshAllHighlights()
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        setPlayerHighlight(targetPlayer, highlightEnabled)
    end

    highlightButton.Text = highlightEnabled
        and "Player Highlights: ON"
        or "Player Highlights: OFF"

    highlightButton.BackgroundColor3 = highlightEnabled
        and Color3.fromRGB(75, 65, 30)
        or DARK
end

highlightButton.Activated:Connect(function()
    highlightEnabled = not highlightEnabled
    refreshAllHighlights()
end)

-- Handle players joining and respawning
local function watchPlayer(targetPlayer)
    targetPlayer.CharacterAdded:Connect(function()
        if highlightEnabled then
            task.wait(0.2)
            setPlayerHighlight(targetPlayer, true)
        end
    end)
end

for _, targetPlayer in ipairs(Players:GetPlayers()) do
    if targetPlayer ~= player then
        watchPlayer(targetPlayer)
    end
end

Players.PlayerAdded:Connect(function(targetPlayer)
    watchPlayer(targetPlayer)
end)

Players.PlayerRemoving:Connect(function(targetPlayer)
    local character = targetPlayer.Character
    if character then
        local existing = character:FindFirstChild("PineappleHighlight")
        if existing then existing:Destroy() end
    end
end)

